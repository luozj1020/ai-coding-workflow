{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Context Compilation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "task_card",
    "task_card_sha256",
    "registry",
    "task_facts",
    "contract_anchors",
    "strategy",
    "coverage",
    "candidate_routes",
    "candidates",
    "output_contract",
    "selected",
    "rescued",
    "omitted",
    "conflict_groups_checked",
    "conflict_free",
    "negative_selected_count",
    "packet_sha256",
    "packet_bytes",
    "hard_contracts_trimmed",
    "model_generated"
  ],
  "properties": {
    "schema": {"const": "aiwf-context-compilation-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "compiled"},
    "task_card": {"type": "string"},
    "task_card_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "task_facts": {"type": "object"},
    "contract_anchors": {"type": "object"},
    "strategy": {"enum": ["coverage", "anchors-only"]},
    "coverage": {"type": "object"},
    "candidate_routes": {"type": "object"},
    "candidates": {"type": "array"},
    "output_contract": {"type": "object"},
    "selected": {"type": "array"},
    "rescued": {"type": "array"},
    "omitted": {"type": "array"},
    "conflict_groups_checked": {"type": "object"},
    "conflict_free": {"const": true},
    "negative_selected_count": {"type": "integer", "minimum": 0},
    "packet_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "packet_bytes": {"type": "integer", "minimum": 0},
    "hard_contracts_trimmed": {"const": false},
    "model_generated": {"const": false},
    "output": {"type": "string"}
  }
}
