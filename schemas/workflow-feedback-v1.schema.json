{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-workflow/schemas/workflow-feedback-v1.schema.json",
  "title": "Workflow Feedback v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "kind", "generated_at", "repository", "task", "signals", "user_feedback", "provenance", "privacy"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "task-feedback"},
        "generated_at": {"type": "string"},
        "repository": {"type": "object"},
        "task": {"type": "object"},
        "signals": {"type": "object"},
        "user_feedback": {"type": "object"},
        "provenance": {"type": "object"},
        "privacy": {"type": "object"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "kind", "generated_at", "record_count", "issue_counts", "rating_averages", "outcome_counts", "privacy"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "feedback-bundle"},
        "generated_at": {"type": "string"},
        "record_count": {"type": "integer", "minimum": 0},
        "issue_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "rating_averages": {"type": "object", "additionalProperties": {"type": "number", "minimum": 1, "maximum": 10}},
        "outcome_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "privacy": {"type": "object"}
      },
      "additionalProperties": false
    }
  ]
}
